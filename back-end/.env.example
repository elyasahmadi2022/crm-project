# -------------------------------------------------------
# Server
# -------------------------------------------------------
PORT=3001
NODE_ENV=development          # development | production
BACKEND_URL=http://localhost:3001   # used to build avatar URLs

# -------------------------------------------------------
# Database (MariaDB / MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# -------------------------------------------------------
DATABASE_URL=mysql://root:password@localhost:3306/crm_luilala

# -------------------------------------------------------
# JWT Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Both are REQUIRED — the app refuses to start without them.
# -------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# -------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -------------------------------------------------------
# Email / SMTP  (used for OTP password-reset emails)
# For local dev use Mailtrap: https://mailtrap.io
# For production use SendGrid, SES, Postmark, etc.
# -------------------------------------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=your_mailtrap_username
MAIL_PASS=your_mailtrap_password
MAIL_FROM="Luilala CRM" <noreply@luilala.com>

# -------------------------------------------------------
# File uploads
# -------------------------------------------------------
UPLOAD_DIR=uploads/avatars    # relative to the project root
